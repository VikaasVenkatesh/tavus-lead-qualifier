# Required: from https://platform.tavus.io (API keys)
TAVUS_API_KEY=

# Written by `npm run setup` (scripts/setup-tavus.ts)
TAVUS_PAL_ID=
TAVUS_FACE_ID=

# Optional: second PAL for the two-agent demo (/?demo=1). Also written by setup.
TAVUS_HOMEOWNER_PAL_ID=
TAVUS_HOMEOWNER_FACE_ID=

# Optional: Neon Postgres. Without it, leads go to data/leads.json locally (or memory on Vercel).
DATABASE_URL=
